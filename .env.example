# Application
PROJECT_NAME="Menstrual Tracking API"
VERSION="1.0.0"
ENVIRONMENT="development"

# API
API_V1_STR="/api/v1"

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Database
POSTGRES_SERVER="db"  # Use "db" in Docker, "localhost" for local development
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="menstrual_tracking"
POSTGRES_PORT="5432"

# Redis
REDIS_HOST="redis"  # Use "redis" in Docker, "localhost" for local development
REDIS_PORT=6379
REDIS_DB=0

# OpenRouter API
OPENROUTER_API_KEY="your_api_key_here"
OPENROUTER_API_URL="https://openrouter.ai/api/v1"
